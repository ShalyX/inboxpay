# Public Supabase configuration
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase configuration
SUPABASE_SECRET_KEY=
# Legacy fallback only:
SUPABASE_SERVICE_ROLE_KEY=

# Gmail Web OAuth
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Optional comma-separated HTTPS origins; replaces the two built-in production origins.
# Register each origin + /api/gmail/callback in Google before enabling it here.
GMAIL_OAUTH_ALLOWED_ORIGINS=https://inboxpay.vercel.app,https://tameion-ap-agent-live.vercel.app
INBOXPAY_TOKEN_ENCRYPTION_KEY=

# Circle Testnet
CIRCLE_TEST_API_KEY=
CIRCLE_TEST_ENTITY_SECRET=

# Circle live
CIRCLE_LIVE_API_KEY=
CIRCLE_LIVE_ENTITY_SECRET=

# Arc RPC
ARC_TESTNET_RPC_URL=
ARC_RPC_URL=

# Operation idempotency and worker authentication
INBOXPAY_WALLET_IDEMPOTENCY_SECRET=
AUTONOMY_CRON_SECRET=

# InboxPay-owned Telegram bot. The bot token stays server-only; businesses link chats with one-time codes.
TELEGRAM_BOT_TOKEN=
# Platform operator destination for backup and system failures only. This is never used as a customer fallback.
TELEGRAM_ALERT_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
INBOXPAY_PUBLIC_URL=https://inboxpay.vercel.app
# Generic webhook fallback for non-Telegram receivers.
OPERATIONS_ALERT_WEBHOOK_URL=
OPERATIONS_ALERT_WEBHOOK_SECRET=

# Keep false or unset outside an explicitly approved Mainnet release
INBOXPAY_ALLOW_MAINNET_WRITES=false

# Data-request intake: enable only after migration and support handling are ready.
INBOXPAY_DATA_CONTROLS_ENABLED=false
# Retention runner / GitHub only. Neither value belongs in the browser.
INBOXPAY_RETENTION_ENABLED=false
SUPABASE_RETENTION_SERVICE_KEY=
